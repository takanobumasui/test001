# Server port
PORT=3000

# Arduino serial port
# Mac:   /dev/cu.usbmodem14201  (check Arduino IDE Tools > Port)
# Linux: /dev/ttyUSB0
# Win:   COM3
SERIAL_PORT=/dev/cu.usbmodem14201
SERIAL_BAUD=9600

# Number of LEDs (must match Arduino wiring, max 8)
NUM_LEDS=8

# Camera device for ffmpeg
# Mac:   0  (FaceTime / built-in webcam index)
# Win:   Integrated Camera  (device name shown in Device Manager)
# Linux: /dev/video0
CAMERA_DEVICE=0
